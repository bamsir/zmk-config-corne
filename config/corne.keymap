#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |    Q     |  W  |    E     |     R     |  T  |     |  Y  |     U     |     I    |  O  |     P    |  '   |
// |  -   | LALT / A |  S  | LGUI / D | LCTRL / F |  G  |     |  H  | RCTRL / J | K / RGUI |  L  | RALT / ; | ENTR |
// |  [   |    Z     |  X  |    C     |     V     |  B  |     |  N  |     M     |     ,    |  .  |     /    |   ]  |
//                            | RSE | SPC | LSHFT / TAB |     | BKSP | RSHFT  | LWR |
                        bindings = <
   &kp ESC   &kp Q      &kp W &kp E      &kp R       &kp T   &kp Y &kp U       &kp I      &kp O   &kp P         &kp SQT
   &kp MINUS &mt LALT A &kp S &mt LGUI D &mt LCTRL F &kp G   &kp H &mt RCTRL J &mt RGUI K &kp L   &mt RALT SEMI &kp ENT
   &kp LBKT  &kp Z      &kp X &kp C      &kp V       &kp B   &kp N &kp M       &kp COMMA  &kp DOT &kp FSLH      &kp RBKT
                        &mo RAISE &kp SPACE &mt LSHFT TAB    &kp BSPC &kp RSHFT &mo LOWER
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// | + | BT1 | BT2 | BT3 | BT4 | BT5 |      | BT_CLR |     |     |     |     |  =  |
// | ~ |  1  |  2  |  3  |  4  |  5  |      |   6    |  7  |  8  |  9  |  0  |  `  |
// | ( |  !  |  @  |  #  |  $  |  %  |      |   ^    |  &  |  *  |  |  |  \  |  )  |
//                 |     |     |     |      |        |     |     |
                        bindings = <
   &kp PLUS  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4      &kp BT_CLR &trans   &trans   &trans   &trans   &kp BSPC
   &kp TIDLE &kp N1       &kp N2       &kp N3       &kp N4       &kp N5            &kp N6     &kp N7   &kp N8   &kp N9   &kp N0   &kp GRAVE
   &kp LPAR  &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT         &kp CARET  &kp AMPS &kp STAR &kp PIPE &kp BSLH &kp RPAR
                                       &trans       &trans       &trans            &trans     &trans   &trans
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |      |     | HOME |    UP   |  END   | PG UP |   | F7 | F8 | F9 | F10 | F11 | F12 |
// | ENT  |     | LEFT |   DOWN  | RIGHT  | PG DN |   | F1 | F2 | F3 | F4  | F5  | F6  |
// | BKSP | DEL | PLAY | VOL DWN | VOL UP | MUTE  |   |    |    |    |     |    | CAPS |
//                                |    |     |    |   |    |    |    |
                        bindings = <
   &trans   &trans   &kp HOME &kp UP       &kp END      &kp PG_UP       &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
   &kp ENT  &trans   &kp LEFT &kp DOWN     &kp RIGHT    &kp PG_DN       &kp F1 &kp F2 &kp F3 &kp F4  &kp F5  &kp F6
   &kp BSPC &kp DEL  &kp K_PP &kp K_VOL_DN &KP K_VOL_UP &kp K_MUTE      &trans &trans &trans &trans  &trans  &kp CAPS
                              &trans       &trans       &trans          &trans &trans &trans
                        >;
                };
        };
};
