#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC   &kp Q         &kp W &kp E         &kp R          &kp T         &kp Y &kp U          &kp I         &kp O   &kp P            &kp SQT
                &kp MINUS &ht_bl LALT A &kp S &ht_bl LGUI D &ht_bl LCTRL F &kp G         &kp H &ht_bl RCTRL J &ht_bl RGUI K &kp L   &ht_bl RALT SEMI &kp RET
                &kp LBKT  &kp Z         &kp X &kp C         &kp V          &kp B         &kp N &kp M          &kp COMMA     &kp DOT &kp FSLH         &kp RBKT
                                            &mo 2   &kp SPACE   &ht_bl LSHFT TAB         &kp   BSPC   &kp RSHFT   &mo 1
            >;
        };

        lower_layer {
            bindings = <
                &kp PLUS  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4        &bt BT_CLR &trans   &trans   &trans   &trans   &kp BSPC
                &kp TILDE &kp N1       &kp N2       &kp N3       &kp N4       &kp N5              &kp N6     &kp N7   &kp N8   &kp N9   &kp N0   &kp GRAVE
                &kp LPAR  &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT           &kp CARET  &kp AMPS &kp STAR &kp PIPE &kp BSLH &kp RPAR
                                                          &trans       &trans       &trans        &trans     &trans   &trans
            >;
        };

        raise_layer {
            bindings = <
                &trans   &trans   &kp HOME &kp UP       &kp END      &kp PG_UP          &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &kp RET  &trans   &kp LEFT &kp DOWN     &kp RIGHT    &kp PG_DN          &kp F1 &kp F2 &kp F3 &kp F4  &kp F5  &kp F6
                &kp BSPC &kp DEL  &kp K_PP &kp K_VOL_DN &kp K_VOL_UP &kp K_MUTE         &trans &trans &trans &trans  &trans  &kp CAPS
                                                   &trans     &trans     &trans         &trans   &trans   &trans
            >;
        };
    };
};
