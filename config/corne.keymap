#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC   &kp Q      &kp W &kp E      &kp R       &kp T     /**/     &kp Y &kp U       &kp I      &kp O   &kp P         &kp SQT
                &kp MINUS &hm LALT A &kp S &hm LGUI D &hm LCTRL F &kp G     /**/     &kp H &hm RCTRL J &hm RGUI K &kp L   &hm RALT SEMI &kp RET
                &kp LBKT  &kp Z      &kp X &kp C      &kp V       &kp B     /**/     &kp N &kp M       &kp COMMA  &kp DOT &kp FSLH      &kp RBKT
                                          &hm LSHFT TAB  &mo 2  &kp SPACE   /**/   &kp RSHFT  &mo 1  &kp BSPC
            >;
        };

        lower_layer {
            bindings = <
                &kp GRAVE  &trans   &trans  &trans    &trans    &bt BT_CLR    /**/     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp TILDE
                &kp EQUAL  &kp N1   &kp N2  &kp N3    &kp N4    &kp N5        /**/     &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp PLUS
                &kp LPAR   &kp EXCL &kp AT  &kp HASH  &kp DLLR  &kp PRCNT     /**/     &kp CARET    &kp AMPS     &kp STAR     &kp PIPE     &kp BSLH     &kp RPAR
                                                &trans    &trans    &trans   /**/   &trans     &trans   &trans
            >;
        };

        raise_layer {
            bindings = <
                &kp LG(LS(N4)) &kp LG(LA(LS(N4))) &kp HOME  &kp UP       &kp END      &kp PG_UP      /**/     &kp F7  &kp F8       &kp F9      &kp F10 &kp F11     &kp F12
                &kp RET        &trans             &kp LEFT  &kp DOWN     &kp RIGHT    &kp PG_DN      /**/     &kp F1  &hm RCTRL F2 &hm RGUI F3 &kp F4  &hm RALT F5 &kp F6
                &kp BSPC       &kp DEL            &kp K_PP  &kp K_VOL_DN &kp K_VOL_UP &kp K_MUTE     /**/     &trans  &trans  &trans  &trans   &trans  &kp CAPS
                                                                            &trans  &trans  &trans   /**/   &trans   &trans   &trans
            >;
        };
    };
};
